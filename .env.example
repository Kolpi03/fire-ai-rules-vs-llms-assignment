# Copy to .env (never commit .env). Leave empty to run fully offline: LLM steps are then reported as NOT MEASURED.
GEMINI_API_KEY=
# Any Gemini model with free-tier access; pricing used for cost projections lives in config/settings.yaml
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional Socrata app token: raises NYC Open Data rate limits for the first download
NYC_APP_TOKEN=
